GEMINI_API_KEY=
VECTOR_DB_PATH=/app/data/vectorstore/chroma.sqlite3
TOP_K=10
ALLOWED_HOSTS=localhost,127.0.0.1,chatbot.symphonytech.com

# =============================================================
# DATABASE — uncomment ONE block only
# =============================================================

# -------------------------------------------------------------
# MODE 1: LOCAL DEV
# MySQL running on your development machine.
# FastAPI connects via TCP using host.docker.internal.
# -------------------------------------------------------------
# DB_MODE=local
# DB_HOST=host.docker.internal
# DB_PORT=3306
# DB_NAME=ebookchatbot
# DB_USER=chatbot
# DB_PASSWORD=your_password
# MYSQL_SOCKET_PATH=            <-- not needed, leave blank or omit
# -------------------------------------------------------------
# MODE 2: VPS (Socket)
# MySQL on the same server as Docker.
# FastAPI connects via Unix socket — no network, no % grants.
# -------------------------------------------------------------
 DB_MODE=socket
# DB_HOST=                      <-- not used in socket mode
# DB_PORT=                      <-- not used in socket mode
 DB_NAME=ebookchatbot
 DB_USER=chatbot
 DB_PASSWORD=Stpl@2026
 MYSQL_SOCKET_PATH=/var/run/mysqld/mysqld.sock
# -------------------------------------------------------------
# MODE 3: REMOTE DB (EC2 host MySQL / RDS / managed DB)
# MySQL on a separate server or AWS RDS.
# DB user must allow % host grant.
# -------------------------------------------------------------
# DB_MODE=remote
# DB_HOST=host.docker.internal          # same EC2 host
# DB_HOST=mydb.xxxxxx.ap-south-1.rds.amazonaws.com  # RDS
# DB_HOST=192.168.x.x                   # another server IP
# DB_PORT=3306
# DB_NAME=ebookchatbot
# DB_USER=chatbot
# DB_PASSWORD=your_password
# MYSQL_SOCKET_PATH=            <-- not needed, leave blank or omit
# =============================================================
# NEO4J — dev only (docker-compose.dev.yml runs the container)
# =============================================================
# These are read by the backend AND passed to the neo4j service
# via docker-compose environment: blocks.
# In prod, Neo4j is not containerised — set these to point at
# your external Neo4j instance if you add graph features to prod.
# -------------------------------------------------------------
# NEO4J_URI=bolt://neo4j:7687           # service name resolves inside app-net
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_neo4j_password
