# =============================================================
# DATABASE — uncomment ONE block only
# =============================================================

# -------------------------------------------------------------
# MODE 1: LOCAL DEV
# MySQL running on your development machine.
# Django connects via TCP loopback.
# -------------------------------------------------------------
#DB_MODE=local
#DB_HOST=host.docker.internal
#DB_PORT=3306
#DB_NAME=ebookchatbot
#DB_USER=chatbot
#DB_PASSWORD=Stpl@2026
# MYSQL_SOCKET_PATH=   <-- not needed, leave blank or omit


# -------------------------------------------------------------
# MODE 2: VPS (Socket)
# MySQL on the same server as Docker.
# Django connects via Unix socket — no network, no % grants.
# -------------------------------------------------------------
 DB_MODE=socket
# DB_HOST=                  <-- not used in socket mode
# DB_PORT=                  <-- not used in socket mode
 DB_NAME=ebookchatbot
 DB_USER=chatbot
 DB_PASSWORD=Stpl@2026
 MYSQL_SOCKET_PATH=/var/run/mysqld/mysqld.sock


# -------------------------------------------------------------
# MODE 3: REMOTE DB (EC2 host MySQL / RDS / managed DB)
# MySQL on a separate server or AWS RDS.
# Django connects via TCP — DB user must allow % host.
# -------------------------------------------------------------
# DB_MODE=remote
# DB_HOST=host.docker.internal          # same EC2 host
# DB_HOST=mydb.xxxxxx.ap-south-1.rds.amazonaws.com  # RDS
# DB_HOST=192.168.x.x                   # another server IP
# DB_PORT=3306
# DB_NAME=ebookchatbot
# DB_USER=chatbot
# DB_PASSWORD=Stpl@2026
# MYSQL_SOCKET_PATH=   <-- not needed, leave blank or omit
